{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "worker",
          "format": "url",
          "env": "WORKER_API_URL"
        }
      ]
    },
    "worker": {
      "root": "worker",
      "framework": "fastapi",
      "entrypoint": "app.api:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}

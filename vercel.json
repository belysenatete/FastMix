{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "worker",
          "format": "url",
          "env": "WORKER_API_URL"
        }
      ]
    },
    "worker": {
      "root": "worker",
      "framework": "fastapi",
      "entrypoint": "app.api:app"
    }
  },
  "daemons": {
    "processor": {
      "root": "./",
      "entrypoint": "Dockerfile",
      "command": ["sh", "-c", "python -m app.release && ALERT_WATCHDOG_IN_PROCESSOR=true exec python -m app.worker"],
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
